# ------------------
#  App
# ------------------

# App environment (development | staging | production)
NEXT_PUBLIC_APP_ENV=development

# Enable debug mode without `?debug` query param
NEXT_PUBLIC_FF_DEBUG=

# ------------------
#  Site
# ------------------

# For SEO metadata and generating sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------
#  Mapbox
# ------------------

# Mapbox API key
NEXT_PUBLIC_MAPBOX_TOKEN=

# ------------------
#  Google Analytics
# ------------------

# Unique identifier for a web data stream in GA ("G-XXXXXXXX")
NEXT_PUBLIC_GA_MEASUREMENT_ID=
