@article{zhouRisk2024,
  title = {The Risk of Concurrent Heatwaves and Extreme Sea Levels along the Global Coastline Is Increasing},
  author = {Zhou, Mo and Wang, Shuo},
  date = {2024-04-11},
  journaltitle = {Communications Earth \& Environment},
  shortjournal = {Commun. Earth Environ.},
  volume = {5},
  number = {1},
  pages = {144},
  issn = {2662-4435},
  doi = {10.1038/s43247-024-01274-1},
  url = {https://www.nature.com/articles/s43247-024-01274-1},
  urldate = {2026-10-02},
  abstract = {Abstract             Concurrent heatwaves and extreme sea levels could pose a serious threat to coastal communities under climate change; however, the spatiotemporal characteristics and dynamic evolution of them along global coastline remain poorly understood. Here, we use reanalysis datasets and model projections to assess historical and future changes in global concurrent heatwaves and extreme sea levels. We find that 87.73\% of coastlines experienced such concurrent extremes during 1979–2017. There is an average increase of 3.72 days in the occurrence during 1998–2017 compared to 1979–1998. A one-percentile increase in heatwave intensity is associated with a 2.07\% increase in the likelihood of concurrent extremes. Global coastlines are projected to experience 38 days of concurrent extremes each year during 2025–2049 under the highest emission scenario. The weakening of geopotential height associated with a surface low-pressure system may serve as an important indicator for the occurrence of extreme sea levels during heatwaves.},
  langid = {english}
}
